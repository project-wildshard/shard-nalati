{
  "name": "@wildshard/shard-nalati",
  "version": "0.0.11",
  "private": true,
  "description": "Nalati Grasslands: a Wildshard shard.",
  "type": "module",
  "engines": {
    "node": ">=24.18.0 <27"
  },
  "packageManager": "pnpm@10.34.9",
  "scripts": {
    "prepare": "git rev-parse --is-inside-work-tree >/dev/null 2>&1 && git config core.hooksPath .githooks || true",
    "dev": "wildshard dev src",
    "build": "wildshard build src",
    "typecheck": "npr tsc -p test/tsconfig.json",
    "lint": "node src/scripts/lint.mjs",
    "format:check": "npr oxfmt --check src",
    "fix": "WILDSHARD_RATCHET_FILE=lint/ratchet.json node src/scripts/.kit/bin-tools.mjs -c .oxlintrc.author.json src --fix && npr oxfmt --no-error-on-unmatched-pattern src",
    "format": "npr oxfmt --no-error-on-unmatched-pattern src",
    "test": "pnpm test:kit && pnpm test:shards",
    "check:asks": "node src/scripts/.kit/asks.mjs check",
    "check:agents": "node .githooks/agents-md.mjs lint",
    "check:parity": "node src/scripts/.kit/agent-parity.mjs --strict",
    "check:agent-sync": "node src/scripts/.kit/agent-sync.mjs --check",
    "agents:sync": "node src/scripts/.kit/agent-sync.mjs",
    "md:wrap": "node src/scripts/.kit/md-wrap.mjs",
    "check": "pnpm check:bin-pins && pnpm typecheck && pnpm lint && pnpm format:check --no-error-on-unmatched-pattern && pnpm test:kit && pnpm check:asks && pnpm check:agents && pnpm check:agent-sync && pnpm check:parity && node --check src/scripts/.kit/chromium-keychain-check.mjs && node src/scripts/check-test-boundary.mjs",
    "build:shards": "wildshard build-shards",
    "check:build-twice": "node src/scripts/build-twice.mjs",
    "pack:shards": "node src/scripts/pack-all.mjs",
    "test:kit": "node --test 'src/test/.kit/*.test.mjs' '.githooks/*.test.mjs' '.agents/hooks/test/*.test.mjs'",
    "test:shards": "vitest run",
    "lint:shards": "WILDSHARD_RATCHET_FILE=lint/ratchet.json node src/scripts/.kit/bin-tools.mjs -c .oxlintrc.author.json --deny-warnings src",
    "lint:ci21": "node src/scripts/ci21-wire-retention.mjs && node src/scripts/.kit/bin-tools.mjs --type-aware --tsconfig test/tsconfig.json -c .oxlintrc.author.json --deny-warnings test/nalati-ecology-wire.test.ts test/nalati-view-wires.test.ts test/nalati-loft-author.test.ts test/nalati-geometry-cache-ports.test.ts test/nalati-field-author-ports.test.ts test/nalati-original-species.test.ts test/fixtures/nalati-original-species.ts test/nalati-original-place-binary.test.ts test/fixtures/nalati-native-place-files.ts test/fixtures/nalati-original-place-binary.ts test/nalati-decorative-native.test.ts test/nalati-place-runtime-source.test.ts test/fixtures/nalati-runtime-wire.ts test/nalati-poi-scenes.test.ts test/fixtures/nalati-runtime.ts test/nalati-mounted-specimen-admission.test.ts test/nalati-weapon-grammar.test.ts test/fixtures/nalati-weapon-observation.ts",
    "check:ci21-candidate": "node src/scripts/check-test-boundary.mjs --candidate && npr tsc -p test/tsconfig.ci21-candidate.json && node src/scripts/ci21-wire-retention.mjs test/ci21-candidate-ports.json test/tsconfig.ci21-candidate.json && node src/scripts/ci21-candidate-lint.mjs && vitest run --config vitest.ci21-candidate.config.ts",
    "test:ci21-boundary": "node --test test/candidate-boundary.test.mjs",
    "check:bin-pins": "node src/scripts/.kit/bin-pins.mjs"
  },
  "dependencies": {
    "@wildshard/build": "0.7.0",
    "@wildshard/cli": "0.7.0",
    "@wildshard/dev": "0.7.0",
    "@wildshard/format": "npm:@wildshard/shard-format@0.79.3",
    "@wildshard/kit": "0.7.0",
    "@wildshard/sdk": "0.7.0",
    "playwright": "1.65.0",
    "three": "0.186.0",
    "valibot": "1.5.0"
  },
  "devDependencies": {
    "@types/node": "24.3.1",
    "@types/three": "0.186.0",
    "@typescript/typescript6": "6.0.2",
    "fflate": "0.8.3",
    "happy-dom": "20.14.5",
    "npm-bin-deps": "2.2.0",
    "oxlint": "1.89.0",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  },
