    ],
    "overrides": {
      "binaryen": "npm:@pre-bundled/binaryen@132.0.0-patch-1",
      "assemblyscript>binaryen": "npm:@pre-bundled/binaryen@131.0.0-nightly.20260721-patch-1",
      "@wildshard/sdk>@wildshard/format": "npm:@wildshard/shard-format@0.79.3",
      "@wildshard/build>@wildshard/format": "npm:@wildshard/shard-format@0.79.3",
      "@wildshard/dev>@wildshard/format": "npm:@wildshard/shard-format@0.79.3",
      "@wildshard/upload>@wildshard/format": "npm:@wildshard/shard-format@0.79.3",
      "@wildshard/kit>@wildshard/shard-format": "0.79.3",
      "@wildshard/build": "0.7.0",
      "@wildshard/upload": "0.7.0",
      "@wildshard/sdk": "0.7.0",
      "@wildshard/kit": "0.7.0",
      "@wildshard/dev": "0.7.0",
      "@wildshard/format": "npm:@wildshard/shard-format@0.79.3"
    }
  },
  "binDependencies": {
