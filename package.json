{
  "name": "@wildshard/shard-nalati",
  "version": "0.0.0",
  "private": true,
  "description": "Nalati Grasslands: a Wildshard shard.",
  "type": "module",
  "bin": {
    "shard-nalati": "./kit/cli/main.ts"
  },
  "engines": {
    "node": ">=24.18.0"
  },
  "packageManager": "pnpm@10.34.9",
  "scripts": {
    "prepare": "git rev-parse --is-inside-work-tree >/dev/null 2>&1 && git config core.hooksPath .githooks || true",
    "typecheck": "npr tsc -p kit/tsconfig.json && npr tsc -p test/tsconfig.json",
    "lint": "node scripts/lint.mjs",
    "lint:fix": "node kit/scripts/lint.mjs --type-aware --fix --ignore-pattern '.githooks/**' --ignore-pattern '.agents/**' --ignore-pattern 'scripts/agent-parity.mjs' --ignore-pattern 'scripts/agent-sync.mjs' --ignore-pattern 'tmp/**'",
    "format": "npr oxfmt -c kit/.oxfmtrc.json kit '!src/**' '!test/**' '!.oxlintrc.author.json'",
    "format:check": "npr oxfmt -c kit/.oxfmtrc.json --check kit '!src/**' '!test/**' '!.oxlintrc.author.json'",
    "test": "pnpm test:kit && pnpm test:shards",
    "check:asks": "node kit/scripts/asks.mjs check",
    "check:agents": "node .githooks/agents-md.mjs lint",
    "check:parity": "node scripts/agent-parity.mjs --strict",
    "check:agent-sync": "node scripts/agent-sync.mjs --check",
    "test:agent-hooks": "node --test '.agents/hooks/test/*.test.mjs'",
    "agents:sync": "node scripts/agent-sync.mjs",
    "md:wrap": "node kit/scripts/md-wrap.mjs",
    "test:hooks": "node --test '.githooks/*.test.mjs'",
    "check": "pnpm check:bin-pins && pnpm typecheck && pnpm lint && pnpm format:check && pnpm test:kit && pnpm check:asks && pnpm check:agents && pnpm check:agent-sync && pnpm test:agent-hooks && pnpm check:parity && node --check scripts/chromium-keychain-check.mjs && node --test test/tooling/chrome-keychain.test.mjs test/tooling/worktree-guard.test.mjs test/tooling/disk-land.test.mjs test/tooling/lane-live.test.mjs test/tooling/keep-copy.test.mjs test/tooling/leftovers-report.test.mjs test/tooling/reap-report.test.mjs && node scripts/check-test-boundary.mjs",
    "build:shards": "node scripts/publish-public.mjs && wildshard build-shards",
    "check:build-twice": "node scripts/build-twice.mjs",
    "pack:shards": "node scripts/pack-all.mjs",
    "test:kit": "node --test 'kit/cli/*.test.ts' 'kit/test/**/*.test.ts'",
    "test:shards": "vitest run",
    "lint:shards": "WILDSHARD_RATCHET_FILE=lint/ratchet.json node kit/scripts/bin-tools.mjs -c .oxlintrc.author.json --deny-warnings src",
    "lint:ci21": "node scripts/ci21-wire-retention.mjs && node kit/scripts/bin-tools.mjs --type-aware --tsconfig test/tsconfig.json -c .oxlintrc.author.json --deny-warnings test/nalati-ecology-wire.test.ts test/nalati-view-wires.test.ts test/nalati-loft-author.test.ts test/nalati-geometry-cache-ports.test.ts test/nalati-field-author-ports.test.ts test/nalati-original-species.test.ts test/fixtures/nalati-original-species.ts test/nalati-original-place-binary.test.ts test/fixtures/nalati-native-place-files.ts test/fixtures/nalati-original-place-binary.ts test/nalati-decorative-native.test.ts test/nalati-place-runtime-source.test.ts test/fixtures/nalati-runtime-wire.ts test/nalati-poi-scenes.test.ts test/fixtures/nalati-runtime.ts test/nalati-mounted-specimen-admission.test.ts test/nalati-weapon-grammar.test.ts test/fixtures/nalati-weapon-observation.ts",
    "check:ci21-candidate": "node scripts/check-test-boundary.mjs --candidate && npr tsc -p test/tsconfig.ci21-candidate.json && node scripts/ci21-wire-retention.mjs test/ci21-candidate-ports.json test/tsconfig.ci21-candidate.json && node scripts/ci21-candidate-lint.mjs && vitest run --config vitest.ci21-candidate.config.ts",
    "lint:kit": "node kit/scripts/lint.mjs --type-aware --deny-warnings --ignore-pattern '.githooks/**' --ignore-pattern '.agents/**' --ignore-pattern 'scripts/agent-parity.mjs' --ignore-pattern 'scripts/agent-sync.mjs' --ignore-pattern 'tmp/**' --ignore-pattern 'src/**' --ignore-pattern 'test/**' --ignore-pattern 'public/**' --ignore-pattern 'scripts/**' --ignore-pattern 'vitest.config.ts' --no-error-on-unmatched-pattern",
    "test:ci21-boundary": "node --test test/tooling/candidate-boundary.test.mjs",
    "check:bin-pins": "node kit/scripts/bin-pins.mjs"
  },
  "dependencies": {
    "@wildshard/engine": "0.1.18",
    "@wildshard/format": "npm:@wildshard/shard-format@0.26.0",
    "@wildshard/sharddev": "npm:@wildshard/sdk@0.2.12",
    "playwright": "1.65.0",
    "three": "0.186.0",
    "valibot": "1.5.0"
  },
  "devDependencies": {
    "@types/node": "24.3.1",
    "@types/three": "0.186.0",
    "@typescript/typescript6": "6.0.2",
    "fflate": "0.8.3",
    "happy-dom": "20.14.5",
    "oxlint": "1.89.0",
    "vite": "8.3.0",
    "vitest": "5.0.1",
    "npm-bin-deps": "2.1.0"
  },
  "pnpm": {
    "ignoredOptionalDependencies": [
      "@esbuild/aix-ppc64",
      "@esbuild/android-arm",
      "@esbuild/android-arm64",
      "@esbuild/android-x64",
      "@esbuild/darwin-x64",
      "@esbuild/freebsd-arm64",
      "@esbuild/freebsd-x64",
      "@esbuild/linux-arm",
      "@esbuild/linux-arm64",
      "@esbuild/linux-ia32",
      "@esbuild/linux-loong64",
      "@esbuild/linux-mips64el",
      "@esbuild/linux-ppc64",
      "@esbuild/linux-riscv64",
      "@esbuild/linux-s390x",
      "@esbuild/netbsd-arm64",
      "@esbuild/netbsd-x64",
      "@esbuild/openbsd-arm64",
      "@esbuild/openbsd-x64",
      "@esbuild/openharmony-arm64",
      "@esbuild/sunos-x64",
      "@esbuild/win32-arm64",
      "@esbuild/win32-ia32",
      "@esbuild/win32-x64",
      "@oxfmt/binding-android-arm-eabi",
      "@oxfmt/binding-android-arm64",
      "@oxfmt/binding-darwin-x64",
      "@oxfmt/binding-freebsd-x64",
      "@oxfmt/binding-linux-arm-gnueabihf",
      "@oxfmt/binding-linux-arm-musleabihf",
      "@oxfmt/binding-linux-arm64-gnu",
      "@oxfmt/binding-linux-arm64-musl",
      "@oxfmt/binding-linux-ppc64-gnu",
      "@oxfmt/binding-linux-riscv64-gnu",
      "@oxfmt/binding-linux-riscv64-musl",
      "@oxfmt/binding-linux-s390x-gnu",
      "@oxfmt/binding-linux-x64-musl",
      "@oxfmt/binding-openharmony-arm64",
      "@oxfmt/binding-win32-arm64-msvc",
      "@oxfmt/binding-win32-ia32-msvc",
      "@oxfmt/binding-win32-x64-msvc",
      "@oxlint-tsgolint/darwin-x64",
      "@oxlint-tsgolint/linux-arm64",
      "@oxlint-tsgolint/win32-arm64",
      "@oxlint-tsgolint/win32-x64",
      "@oxlint/binding-android-arm-eabi",
      "@oxlint/binding-android-arm64",
      "@oxlint/binding-darwin-x64",
      "@oxlint/binding-freebsd-x64",
      "@oxlint/binding-linux-arm-gnueabihf",
      "@oxlint/binding-linux-arm-musleabihf",
      "@oxlint/binding-linux-arm64-gnu",
      "@oxlint/binding-linux-arm64-musl",
      "@oxlint/binding-linux-ppc64-gnu",
      "@oxlint/binding-linux-riscv64-gnu",
      "@oxlint/binding-linux-riscv64-musl",
      "@oxlint/binding-linux-s390x-gnu",
      "@oxlint/binding-linux-x64-musl",
      "@oxlint/binding-openharmony-arm64",
      "@oxlint/binding-win32-arm64-msvc",
      "@oxlint/binding-win32-ia32-msvc",
      "@oxlint/binding-win32-x64-msvc",
      "@typescript/typescript-aix-ppc64",
      "@typescript/typescript-darwin-x64",
      "@typescript/typescript-freebsd-arm64",
      "@typescript/typescript-freebsd-x64",
      "@typescript/typescript-linux-arm",
      "@typescript/typescript-linux-arm64",
      "@typescript/typescript-linux-loong64",
      "@typescript/typescript-linux-mips64el",
      "@typescript/typescript-linux-ppc64",
      "@typescript/typescript-linux-riscv64",
      "@typescript/typescript-linux-s390x",
      "@typescript/typescript-netbsd-arm64",
      "@typescript/typescript-netbsd-x64",
      "@typescript/typescript-openbsd-arm64",
      "@typescript/typescript-openbsd-x64",
      "@typescript/typescript-sunos-x64",
      "@typescript/typescript-win32-arm64",
      "@typescript/typescript-win32-x64"
    ],
    "overrides": {
      "@wildshard/engine": "0.1.18",
      "binaryen": "npm:@pre-bundled/binaryen@132.0.0-patch-1",
      "assemblyscript>binaryen": "npm:@pre-bundled/binaryen@131.0.0-nightly.20260721-patch-1",
      "@wildshard/engine@0.1.18>@wildshard/format": "npm:@wildshard/shard-format@0.4.9",
      "@wildshard/sdk@0.2.12>@wildshard/format": "npm:@wildshard/shard-format@0.4.9"
    }
  },
  "binDependencies": {
    "typescript": "7.0.2",
    "oxfmt": "0.74.0",
    "oxlint-tsgolint": "7.0.2004"
  },
  "binDependenciesInstaller": "npm"
}
